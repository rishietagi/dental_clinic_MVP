# Root env for docker compose. Copy to .env (which is gitignored) and fill in.
# These are interpolated into the frontend build args in docker-compose.yml.
#
# Supabase Auth (Phase 1). Base project URL (no /rest/v1 suffix) and the
# publishable/anon key — both are NEXT_PUBLIC_*, safe in the browser. Never put
# the service_role secret key here. The backend ALSO uses NEXT_PUBLIC_SUPABASE_URL
# (compose maps it to the backend's SUPABASE_URL) to verify access tokens.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The three staff logins, seeded into staff_user by `python -m app.seed` (1.2, and
# extended to three accounts in 6.12). Each *_USER_ID is that user's Supabase Auth
# UUID (Supabase → Authentication → Users → the user's ID): the seeded row's PRIMARY
# KEY *is* this UUID, so a wrong value means the login authenticates but is rejected
# as "not an active staff member". Compose passes these to the backend container.
#
# These are SHARED ROLE accounts, one per role — not one per person. Which dentist
# treated a patient is recorded by the dentist dropdown, not by who is signed in.

# Admin — the owner. Seeded with roles ["dentist","admin"]: she is both, and must
# not have to log in twice. This is the only login that sees the practice's money
# (the Reports page and the dashboard's "Today's collections" card). REQUIRED.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
ADMIN_EMAIL=admin@clinic.local
ADMIN_NAME=Clinic Admin

# Dentist — roles ["dentist"]. Full clinical work; NO reports, NO day total.
# Optional: leave all three blank to skip creating it.
DENTIST_USER_ID=
DENTIST_EMAIL=
DENTIST_NAME=

# Receptionist — roles ["receptionist"]. Front desk: patients, appointments, and
# billing individual patients — but NO reports and NO day total.
# Optional: leave all three blank to skip creating it.
RECEPTION_USER_ID=
RECEPTION_EMAIL=
RECEPTION_NAME=
