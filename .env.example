# Root env for docker compose. Copy to .env (which is gitignored) and fill in.
# These are interpolated into the frontend build args in docker-compose.yml.
#
# Supabase Auth (Phase 1). Base project URL (no /rest/v1 suffix) and the
# publishable/anon key — both are NEXT_PUBLIC_*, safe in the browser. Never put
# the service_role secret key here. The backend ALSO uses NEXT_PUBLIC_SUPABASE_URL
# (compose maps it to the backend's SUPABASE_URL) to verify access tokens.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Admin to seed into staff_user (backend `python -m app.seed`, step 1.2).
# ADMIN_USER_ID is the admin's Supabase Auth UUID (Supabase → Authentication →
# Users → the user's ID). Compose passes these to the backend container.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
ADMIN_EMAIL=admin@clinic.local
ADMIN_NAME=Clinic Admin
