# Root env for docker compose. Copy to .env (which is gitignored) and fill in.
# These are interpolated into the frontend build args in docker-compose.yml.
#
# There is NO authentication as of 10.1 — the app is a single-user desktop app,
# so there are no Supabase keys and no login accounts to configure. What used to
# live here (NEXT_PUBLIC_SUPABASE_*, ADMIN_*/DENTIST_*/RECEPTION_*) is all gone.

# The one staff row every action is attributed to. Leave blank to use the
# defaults in backend/app/config.py — that is what dev normally wants. Create the
# row with: docker compose run --rm backend python -m app.seed
LOCAL_STAFF_ID=
LOCAL_STAFF_EMAIL=
LOCAL_STAFF_NAME=
