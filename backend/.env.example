# Copy to backend/.env and adjust. The real .env is gitignored — never commit it.

# Postgres connection string. Unused until step 0.5.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinic

# development | production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Admin to seed into staff_user (used by `python -m app.seed`, step 1.2).
# ADMIN_USER_ID is the admin's Supabase Auth UUID — copy it from the Supabase
# dashboard: Authentication → Users → click the user → its ID. The seeded row's
# primary key IS this UUID, so a verified JWT (its `sub`) maps straight to it.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
ADMIN_EMAIL=admin@clinic.local
ADMIN_NAME=Clinic Admin
