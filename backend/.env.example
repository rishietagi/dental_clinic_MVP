# Copy to backend/.env and adjust. The real .env is gitignored — never commit it.

# Postgres connection string. Unused until step 0.5.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinic

# development | production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Base Supabase project URL (no trailing path). Used to verify access tokens:
# the JWKS URL and expected issuer are derived from it. Same value as the
# frontend's NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# The three staff logins seeded into staff_user by `python -m app.seed` (1.2,
# extended to three accounts in 6.12). Each *_USER_ID is that user's Supabase Auth
# UUID — copy it from the Supabase dashboard: Authentication → Users → click the
# user → its ID. The seeded row's primary key IS this UUID, so a verified JWT (its
# `sub`) maps straight to it; a wrong value authenticates but is then rejected as
# "not an active staff member".
#
# Shared ROLE accounts, one per role — not one per person.

# Admin — the owner, roles ["dentist","admin"] (she is both; one login, not two).
# The only login that sees the practice's money: Reports + today's collections.
# REQUIRED.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
ADMIN_EMAIL=admin@clinic.local
ADMIN_NAME=Clinic Admin

# Dentist — roles ["dentist"]. Clinical work; no reports, no day total. Optional.
DENTIST_USER_ID=
DENTIST_EMAIL=
DENTIST_NAME=

# Receptionist — roles ["receptionist"]. Front desk incl. billing an individual
# patient; no reports, no day total. Optional.
RECEPTION_USER_ID=
RECEPTION_EMAIL=
RECEPTION_NAME=
