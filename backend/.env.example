# Copy to backend/.env and adjust. The real .env is gitignored — never commit it.

# Postgres connection string. Unused until step 0.5.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinic

# development | production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# There is NO authentication as of 10.1 — this is a single-user desktop app, so
# there is no Supabase project and no token to verify.
#
# The one staff row every write is attributed to (audit_log.actor_id,
# visit.dentist_id). Leave blank to use the defaults in app/config.py. Create the
# row with `python -m app.seed`. The id is FIXED on purpose: if it changed, every
# existing audit row and visit would point at a staff member that no longer exists.
LOCAL_STAFF_ID=
LOCAL_STAFF_EMAIL=
LOCAL_STAFF_NAME=
