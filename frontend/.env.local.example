# Frontend env for running `npm run dev` outside Docker. Copy to .env.local
# (gitignored). Under Docker these come from build args in docker-compose.yml.

# The backend base URL the browser calls. INLINED AT BUILD TIME — it is baked
# into the JS bundle by `npm run build`, not read at runtime, so changing it
# means rebuilding.
#   http://localhost/api    through Caddy (Docker)
#   http://localhost:8000   backend directly (by-hand dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# There is NO authentication as of 10.1 — the Supabase keys that used to live
# here are gone along with the login screen. See backend/app/auth.py.
