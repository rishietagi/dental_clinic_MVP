# Copy to frontend/.env.local. The real .env.local is gitignored.

# Base URL of the FastAPI backend, as seen FROM THE BROWSER.
# NEXT_PUBLIC_* vars are inlined at BUILD time and run in the user's browser,
# so this must never be a Docker service hostname like http://backend:8000 —
# a clinic PC cannot resolve that. Use a URL the browser can actually reach.
NEXT_PUBLIC_API_URL=http://localhost:8000
