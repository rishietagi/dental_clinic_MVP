{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dental Clinic",
  "version": "0.1.0",
  "identifier": "in.clinic.dental",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "title": "Dental Clinic",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Dental Clinic",
    "category": "Business",
    "shortDescription": "Dental clinic management",
    "longDescription": "Patient records, appointments, clinical notes, dental charting, billing and lab tracking for a single dental practice. Runs entirely on this computer.",
    "resources": {
      "../../dist/ClinicApp/": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
